{
  "name": "beautyhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "npx prisma validate",
    "prisma:generate": "npx prisma generate",
    "migrate:new": "npx prisma migrate dev --create-only",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:ui-text": "node scripts/check-ui-text.mjs",
    "check:dead-classes": "node scripts/check-dead-classes.mjs",
    "check:context-freshness": "node scripts/check-context-freshness.mjs",
    "check:openapi-routes": "node scripts/check-openapi-routes.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:include-where": "node scripts/check-include-where.mjs",
    "check:worker-boot": "node scripts/check-worker-boot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run prisma:validate && npm run prisma:generate && npm run openapi:generate && npm run check:encoding && npm run check:mojibake && npm run check:ui-text && npm run check:dead-classes && npm run check:error-message-lang && npm run check:env-discipline && npm run check:context-freshness && npm run check:openapi-routes && npm run check:schema-drift && npm run check:migration-drops && npm run check:include-where && npm run check:worker-boot && npm run smoke",
    "check:error-message-lang": "node scripts/check-error-message-lang.mjs",
    "check:env-discipline": "node scripts/check-env-discipline.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:tz": "node scripts/check-tz.mjs",
    "db:reset:dev": "npx prisma migrate reset --force && npm run redis:flush:dev && npm run seed:test",
    "redis:flush:dev": "node scripts/dev-redis-flush.mjs",
    "worker:build": "npx tsc --noEmit",
    "worker": "npx --yes tsx --conditions=react-server src/worker.ts",
    "seed:test": "npx tsx prisma/seeds/test-data/index.ts",
    "seed:test:reset": "npx tsx prisma/seeds/test-data/reset.ts",
    "seed:billing": "npx tsx scripts/seed-billing-plans.ts",
    "seed:plans": "npx tsx scripts/seed-billing-plans.ts",
    "seed:review-tags": "npx tsx scripts/seed-review-tags.ts",
    "migrate:billing": "npx tsx scripts/migrate-billing-plans.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lighthouse": "npx tsx scripts/lighthouse-audit.ts",
    "analyze": "cross-env ANALYZE=true npm run build",
    "media:audit": "npx tsx scripts/audit-media-assets.ts",
    "media:cleanup": "npx tsx scripts/cleanup-orphan-media.ts",
    "cities:unpublish-no-address": "npx tsx scripts/unpublish-providers-without-address.ts",
    "cities:backfill": "npx tsx scripts/backfill-cities-from-addresses.ts",
    "check:migration-drops": "node scripts/check-migration-drops.mjs"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/browser": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-virtual": "^3.13.18",
    "file-type": "^20.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.541.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "openai": "^6.27.0",
    "prisma": "^6.19.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "redis": "^5.10.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "swr": "^2.4.0",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "lighthouse": "^13.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
