# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Public env templates — tracked so fresh clones inherit the full var list
# operators need to fill in. Both files contain only `replace-with-*` /
# placeholder values, no real secrets (verified by SECURITY-AUDIT-A +
# PROD-ENV-EXAMPLE-SYNC-A). Real `.env` / `.env.production` stays ignored
# above. Without these re-includes, the DEPLOYMENT-READINESS-AUDIT-A DR-1
# fix (synced prod template) lives only on the maintainer's disk —
# defeating the purpose of a checked-in template.
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
_tmp_api_routes.txt
.claude
prisma/seed-test.sql
prisma/seed.sql
prisma/seed.sh

# Operational docs (runbooks, internal guides) live outside git by convention.
# `docs/*` ignores contents but not the directory itself, so specific files
# can be re-included via `!docs/<file>` below.
docs/*
docs/runbooks/
# Shareable knowledge docs — tracked so a second developer / future Claude
# session inherits sprint meta-lessons without needing the original sprint
# context. SPRINT-PATTERNS references QUALITY-GATES as its companion, so
# both must be visible for cross-doc links to work for fresh-clone readers.
!docs/SPRINT-PATTERNS.md
!docs/QUALITY-GATES.md
!docs/AI-MIGRATION-STRATEGY.md
!docs/AUTH-PROVIDER-ABSTRACTION-PLAN.md
!docs/migration-samples/
!docs/migration-samples/**

# Graphify knowledge graph output (regeneratable via `graphify update .`)
# Excludes graph.json (large, derived) + GRAPH_REPORT.md (large, derived) + cache.
# Skill manifest + CLAUDE.md + .claude/settings.json hook are version-controlled separately.
graphify-out/

# QA harness (QA-01): live session storage-state + screenshots are never committed.
# The harness code (.qa/*.ts), playwright.config.ts and QA-FINDINGS.md ARE tracked.
.qa/auth/
.qa/screenshots/
.qa/smoke-results.json
.qa/*.log
# Playwright run artifacts (generated by `npx playwright test` / MCP browser).
test-results/
playwright-report/
.playwright-mcp/

.qa/diagnostics/
.qa/snapshots/
.qa/auth/          # сессии с токенами — проверь, возможно уже есть
.claude/settings.local.json

# next-pwa generated service-worker artifacts (PWA-ARTIFACTS-GITIGNORE 2026-06-30).
# Regenerated on every `npm run build` with new content-hashes (fallback-<hash>.js),
# so tracking them churns the tree + pollutes commits. dest:"public" emits these:
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/worker-*.js
session-audit/
