# ─── Stage 1: Full deps + Prisma generate ────────────────────────────────────
# prisma CLI (in devDeps) is needed only for generate; we copy the output to stage 2.
FROM node:20-alpine AS prisma-builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate

# ─── Stage 2: Production runtime ─────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat

# Production dependencies only (tsx + prisma are now in dependencies)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy the generated Prisma client from the full-deps stage
COPY --from=prisma-builder /app/node_modules/.prisma ./node_modules/.prisma

# Source files required by the worker
COPY tsconfig.json ./
COPY prisma ./prisma
COPY src ./src

ENV NODE_ENV=production

# Drop root: run as the image's built-in unprivileged `node` user (uid 1000).
# The worker only READS its code + the Prisma engine (all world-readable) and
# talks to Postgres/Redis/S3 over the network — it never writes to the container
# filesystem — so no chown of the root-owned copies is needed. Mirrors the app
# image's non-root `nextjs` user (Dockerfile) so neither long-running process
# runs as root.
USER node

# WORKER-BOOT-SERVER-ONLY-01: the worker is a legitimate server runtime that
# transitively imports `server-only`-guarded modules (redis/connection, prisma).
# Under plain Node (tsx), `server-only` resolves to its throwing `index.js` and
# kills the process at import. Passing Node's `react-server` condition — the
# escape the package itself provides — resolves it to the no-op `empty.js`.
# The flag is an explicit tsx arg (not NODE_OPTIONS) so `env_file` can't clobber
# it; exec-form CMD keeps tsx as PID 1 for graceful SIGTERM shutdown.
# MUST stay in lockstep with the `worker` npm script (package.json).
CMD ["node_modules/.bin/tsx", "--conditions=react-server", "src/worker.ts"]
