# Runtime
NODE_ENV=development

# ── Core (required) ──────────────────────────────────────────────────────────
# Local dev: defaults match docker-compose.dev.yml (db=masterryadom, user=master, password=master123).
DATABASE_URL=postgresql://master:master123@localhost:5432/masterryadom
# Optional: for PgBouncer / connection pooler (used by prisma migrate).
# Local dev: leave blank OR set to the same value as DATABASE_URL (no pooler in dev).
DIRECT_URL=
AUTH_JWT_SECRET=replace-with-at-least-32-char-random-secret
OTP_HMAC_SECRET=replace-with-at-least-16-char-random-secret

# ── Server ───────────────────────────────────────────────────────────────────
# Required in production — used by worker health endpoint
WORKER_SECRET=dev-worker-secret
# Required in production — cron trigger for subscription auto-renewal
BILLING_RENEW_SECRET=
# Required in production — cron trigger for daily MRR snapshot
#   POST /api/billing/mrr/snapshot/run, header x-cron-token: <secret>
#   Run once per UTC day (e.g. 02:00 UTC). Idempotent.
MRR_SNAPSHOT_SECRET=
# Token for the catalog "availableToday" recompute trigger (fail-closed).
#   POST /api/catalog/available-today/run, header x-cron-token: <secret>
#   Phase 3 schedules a ~30-min in-worker sweep; this is the on-demand trigger.
AVAILABILITY_CRON_TOKEN=
# Required in production — signing key for private media delivery URLs
MEDIA_DELIVERY_SECRET=
# Public base URL of the app (e.g. https://masterryadom.ru). Used for links in emails/notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side fallback for APP_PUBLIC_URL when NEXT_PUBLIC_APP_URL is not available
APP_PUBLIC_URL=

# ── Redis (required in production) ────────────────────────────────────────────
# Required in production for rate-limit, queue, cache, pub/sub
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=

# ── Timezone & locale ─────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Moscow

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# SEC-23: корень НЕ внутри public/ — иначе Next раздаёт вложения чата и фото
# клиентских карточек статикой по /uploads/..., мимо ensureCanReadMedia.
# STORAGE_PROVIDER=local в production отвергается на старте (см. src/lib/env.ts).
MEDIA_LOCAL_ROOT=./.media-uploads
# If set, local media is served at this URL directly. Leave empty to proxy through /api/media
MEDIA_LOCAL_PUBLIC_URL=

# S3 storage — required when STORAGE_PROVIDER=s3.
# Любой S3-совместимый провайдер: клиент ходит по path-style и не шлёт
# checksum-заголовки (см. src/lib/media/storage/s3.ts). Значения ниже —
# Yandex Object Storage; для Cloud.ru Object Storage возьмите endpoint/region
# из консоли провайдера (docs/runbooks/s3-migration-cloudru.md).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Прямая раздача из бакета. В рантайме НЕ используется (медиа идёт через
# same-origin `/api/media/file/[id]`), поэтому оставляйте пустым.
S3_PUBLIC_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=bh_session

# AUTH-GATE-01 → ENV-SPLIT-01: флаг PHONE_AUTH_ENABLED УДАЛЁН. Phone-вход в
# dev/test включён ВСЕГДА (mock-провайдер логирует OTP — на этом живут
# seed-аккаунты и .qa/-harness); в production — ровно тогда, когда заданы
# SMS_PROVIDER_LOGIN + SMS_PROVIDER_PASSWORD (см. SMS-секцию ниже).

# ── Mobile app (MOBILE-AUTH-A) ───────────────────────────────────────────────
# Версии нативного приложения для GET /api/mobile/v1/config. Ниже MIN — экран
# «Обновите приложение» (жёсткий барьер), ниже LATEST — мягкое предложение.
# Формат MAJOR.MINOR.PATCH без +build. MIN не может быть выше LATEST (иначе
# обновиться не на что — старт падает). Пусто = дефолты 0.0.0 / 1.0.0.
MOBILE_MIN_VERSION_IOS=0.0.0
MOBILE_MIN_VERSION_ANDROID=0.0.0
MOBILE_LATEST_VERSION_IOS=1.0.0
MOBILE_LATEST_VERSION_ANDROID=1.0.0

# ── App Links / Universal Links (MOBILE-POLISH) ──────────────────────────────
# Файлы /.well-known/assetlinks.json (Android) и
# /.well-known/apple-app-site-association (iOS): ссылки https://<домен>/u/* и
# /models/* открываются сразу в приложении. Списки — через запятую.
# Пусто — файл отвечает 404, ссылки открываются в браузере.
# Пакет Android (пусто = ru.masterryadom).
MOBILE_ANDROID_PACKAGE=
# SHA-256 отпечатки сертификата подписи (Play Console → Целостность приложения
# → сертификат ключа подписи; для отладочной сборки — отпечаток debug-ключа):
# AA:BB:…:FF, 32 байта, регистр не важен.
MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=
# App ID iOS: <TEAMID>.<bundle id>, например ABCDE12345.ru.masterryadom.
MOBILE_IOS_APP_IDS=

# ── Trusted proxy / client-IP derivation (HARDENING-08) ──────────────────────
# Number of trusted reverse-proxy hops in front of the app. Client IP = the
# entry N-from-the-RIGHT of X-Forwarded-For (never the spoofable leftmost).
# Default 1 = single reverse proxy (dev: no XFF → falls through, harmless).
# Set to match prod EXACTLY (e.g. 2 for CDN+LB) — too-high re-opens the spoof.
TRUSTED_PROXY_HOPS=1
# Optional: a dedicated real-IP header the edge OVERWRITES (e.g. x-real-ip).
# Leave empty unless the edge is confirmed to set it (otherwise spoofable).
TRUSTED_REAL_IP_HEADER=

# Telegram Login Widget
# ENV-SPLIT-01: флаг NEXT_PUBLIC_TELEGRAM_ENABLED УДАЛЁН — пользовательский
# Telegram включён наличием NEXT_PUBLIC_TELEGRAM_BOT_USERNAME (в проде вместе
# с TELEGRAM_BOT_TOKEN, env-refine). Пусто = Telegram выключен. Не влияет на
# ops-мониторинг (MONITORING_TELEGRAM_*).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# VK OAuth
# Canonical names below. The VK_ID_* aliases (VK_ID_CLIENT_ID/_SECRET/_REDIRECT_URI)
# are also accepted + validated (post-FIX-PREDEPLOY-GAPS) — set ONE set, not both.
# ENV-SPLIT-01: флаг NEXT_PUBLIC_VK_ENABLED УДАЛЁН — VK-вход включён наличием
# VK_CLIENT_ID (пусто = выключен). Флаг NEXT_PUBLIC_VK_NOTIFICATIONS_ENABLED
# тоже УДАЛЁН: канала доставки нет, доступность захардкожена в коде
# (src/lib/vk/notifications-availability.ts).
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# Yandex OAuth (Yandex ID) — FIX-YANDEX-OAUTH.
# Register a Yandex OAuth app (https://oauth.yandex.ru) with scopes
# login:info / login:email / login:avatar + a redirect_uri pointing at
# /api/auth/yandex/callback, then set the creds.
# ENV-SPLIT-01: флаг NEXT_PUBLIC_YANDEX_ENABLED УДАЛЁН — кнопка появляется с
# заданным YANDEX_OAUTH_CLIENT_ID (пусто = выключено).
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_SECRET=
YANDEX_OAUTH_REDIRECT_URI=

# ── Payments ──────────────────────────────────────────────────────────────────
# Required in production
YOOKASSA_SECRET_KEY=replace-with-yookassa-secret
YOOKASSA_SHOP_ID=replace-with-yookassa-shop-id
# Webhook URL query secret (NOT a signature — YooKassa doesn't sign).
# When set, configure the ЛК webhook URL with ?token=<value>:
#   https://<host>/api/payments/yookassa/webhook?token=<value>
#
# HARDENING-MISC-01: REQUIRED IN PRODUCTION when payments are enabled
# (YOOKASSA_SHOP_ID + YOOKASSA_SECRET_KEY set) — the app refuses to start
# without it. Optional in dev/test, which is why this template leaves it blank.
# It is a cheap pre-filter, NOT the authenticity anchor (that is the worker's
# API re-fetch, invariant #5).
YOOKASSA_WEBHOOK_TOKEN=
# ENV-SPLIT-01: флаг YOOKASSA_IP_ALLOWLIST_ENFORCED УДАЛЁН — allowlist всегда
# log-only (ратифицированная поза PAY-SEC-01; якорь подлинности — re-fetch).

# ── Push notifications ────────────────────────────────────────────────────────
# Optional: push is gracefully disabled when these are absent
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# ── Native push в приложение (MOBILE-B2) ──────────────────────────────────────
# Отправка push в нативное приложение (FCM / APNs / RuStore). ВЫКЛЮЧАТЕЛЬ
# ОТПРАВКИ, а не конфигурации: FCM и APNs — серверы за пределами РФ, до
# вердикта юриста по RKN-AUDIT-01 в проде держать пустым/false. Регистрация
# устройств работает и без него. Только "true" включает.
MOBILE_PUSH_SENDING_ENABLED=
# FCM HTTP v1 (Android с Google-сервисами) — из JSON-ключа сервисного
# аккаунта Firebase (project_id / client_email / private_key). Ключ — PEM,
# переводы строк можно записать как \n в одну строку. Неполный набор = FCM
# выключен (в проде — отказ на старте).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# APNs (iOS), токенная авторизация ключом .p8: Team ID, Key ID, сам ключ (PEM,
# \n допустимы) и bundle id приложения (apns-topic).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# RuStore Push (Android без Google-сервисов): ID проекта и сервисный токен из
# консоли RuStore.
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=

# ── Maps & geocoding ──────────────────────────────────────────────────────────
YANDEX_GEOCODER_API_KEY=replace-with-yandex-geocoder-key
YANDEX_SUGGEST_API_KEY=replace-with-yandex-suggest-key
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Real legal ИНН shown in the footer requisites. Leave blank in dev — the footer
# renders an obvious "[не указан]" placeholder. Set the real value before launch.
NEXT_PUBLIC_LEGAL_INN=
# FOOTER-VK: VK community URL for the footer social link. Leave blank in dev — the
# footer omits the VK icon when unset (no stale/wrong handle). Set the real
# МастерРядом community URL before launch.
NEXT_PUBLIC_VK_COMMUNITY_URL=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Required for email OTP login and support ticket notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="МастерРядом <noreply@example.com>"
SUPPORT_TO=support@example.com
# Partnership inquiries from /partners. Falls back to SUPPORT_TO when unset.
SUPPORT_TO_PARTNERSHIP=partners@example.com
# ENV-SPLIT-01: килсвитч EMAIL_AUTH_ENABLED УДАЛЁН — email-вход доступен, когда
# настроен SMTP выше.

# ── AI chat + visual search (both on Yandex) ─────────────────────────────────
# Chat surfaces AND visual search go through Yandex Cloud. Chat uses the
# Foundation Models OpenAI-compatible endpoint (https://llm.api.cloud.yandex.net/v1);
# visual search uses AI Studio multimodal (qwen3.6-35b-a3b) + text-search-doc/query
# embeddings (VISUAL-SEARCH-YANDEX-MIGRATION-01).
# ENV-SPLIT-01: флаги AI_FEATURES_ENABLED / VISUAL_SEARCH_ENABLED УДАЛЕНЫ — обе
# AI-поверхности включаются заданием ОБЕИХ переменных ниже (пусто = 503
# gracefully, удобно для dev без ключей).
#   • YANDEX_API_KEY = service account API key, scope yc.ai.foundationModels.execute
#   • YANDEX_FOLDER_ID = folder identifier (used in model URI, format b1g...)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# (The vestigial AI_PROVIDER var was removed by ENV-REVISION 2026-07-04; OpenAI
# was dropped by VISUAL-SEARCH-YANDEX-MIGRATION-01 — visual search is Yandex now.)

# ── SMS provider (SMSC.ru — https://smsc.ru/api/) ────────────────────────────
# Real SMS delivery for OTP. ENV-SPLIT-01: флаг SMS_PROVIDER_ENABLED УДАЛЁН —
# провайдер включён наличием пары логин+пароль. Пусто = mock-провайдер, OTP
# пишется в лог приложения (dev workflow). В production пустые креды означают
# «phone-вход выключен» (см. Auth-секцию выше). Optional `sender` overrides
# the default registered alpha-sender on your SMSC.ru account.
SMS_PROVIDER_LOGIN=
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_SENDER=
# Low-balance alert threshold in RUB (used by future SMS-MONITORING-A cron).
SMS_LOW_BALANCE_THRESHOLD=500

# ── Monitoring ────────────────────────────────────────────────────────────────
# Optional: Telegram alerts for critical errors
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=

# ── Error tracking — GlitchTip (OBSERVABILITY-GLITCHTIP-01) ───────────────────
# GlitchTip is a self-hosted, Sentry-ingest-compatible backend (@sentry/node +
# @sentry/browser talk to it unchanged). Self-hosted keeps error payloads
# in-country, which SaaS Sentry cannot — the 152-ФЗ reason for the choice.
#
# LEAVE THESE EMPTY IN DEV. With no DSN the SDK is never initialised: no network,
# no overhead, no behaviour change. Set them only to test against a real
# instance. Named GLITCHTIP_* rather than SENTRY_* on purpose — the SDK silently
# reads SENTRY_DSN from the raw environment, which would bypass src/lib/env.ts.
#
# Server + worker DSN.
# SEO-01: коды подтверждения сайта (content мета-тега). Пусто — тега нет.
# Яндекс Вебмастер → «Права доступа» → «Мета-тег»; Google Search Console → «HTML-тег».
YANDEX_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

GLITCHTIP_DSN=
# Browser DSN — a separate var (and ideally a separate GlitchTip project) so
# frontend noise never buries backend failures.
NEXT_PUBLIC_GLITCHTIP_DSN=
# Deployment label in GlitchTip. Defaults to NODE_ENV when empty.
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=
# Release id for grouping events by deploy (e.g. the git SHA).
NEXT_PUBLIC_GLITCHTIP_RELEASE=
# Server-side error sampling, 0..1. Leave at 1 — send everything.
GLITCHTIP_SAMPLE_RATE=1
