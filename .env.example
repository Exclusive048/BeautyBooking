# Runtime
NODE_ENV=development

# ── Core (required) ──────────────────────────────────────────────────────────
# Local dev: defaults match docker-compose.dev.yml (db=masterryadom, user=master, password=master123).
DATABASE_URL=postgresql://master:master123@localhost:5432/masterryadom
# Optional: for PgBouncer / connection pooler (used by prisma migrate).
# Local dev: leave blank OR set to the same value as DATABASE_URL (no pooler in dev).
DIRECT_URL=
AUTH_JWT_SECRET=replace-with-at-least-32-char-random-secret
OTP_HMAC_SECRET=replace-with-at-least-16-char-random-secret

# ── Server ───────────────────────────────────────────────────────────────────
# Required in production — used by worker health endpoint
WORKER_SECRET=dev-worker-secret
# Required in production — cron trigger for subscription auto-renewal
BILLING_RENEW_SECRET=
# Required in production — cron trigger for daily MRR snapshot
#   POST /api/billing/mrr/snapshot/run, header x-cron-token: <secret>
#   Run once per UTC day (e.g. 02:00 UTC). Idempotent.
MRR_SNAPSHOT_SECRET=
# Required in production — signing key for private media delivery URLs
MEDIA_DELIVERY_SECRET=
# Public base URL of the app (e.g. https://beautyhub.art). Used for links in emails/notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side fallback for APP_PUBLIC_URL when NEXT_PUBLIC_APP_URL is not available
APP_PUBLIC_URL=

# ── Redis (required in production) ────────────────────────────────────────────
# Required in production for rate-limit, queue, cache, pub/sub
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=

# ── Timezone & locale ─────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Moscow

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=./public/uploads
# If set, local media is served at this URL directly. Leave empty to proxy through /api/media
MEDIA_LOCAL_PUBLIC_URL=

# S3 storage — required when STORAGE_PROVIDER=s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_PUBLIC_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=bh_session

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# VK OAuth
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=
NEXT_PUBLIC_VK_ENABLED=false
# VK push-notifications subsystem (delivery channel). Independent of
# NEXT_PUBLIC_VK_ENABLED (login). Default off — set to true only after the
# delivery channel in notifications/delivery.ts ships (queue handler + VK
# send API). UI gates the toggle when this is off.
NEXT_PUBLIC_VK_NOTIFICATIONS_ENABLED=false

# ── Payments ──────────────────────────────────────────────────────────────────
# Required in production
YOOKASSA_SECRET_KEY=replace-with-yookassa-secret
YOOKASSA_SHOP_ID=replace-with-yookassa-shop-id
# Optional: webhook bearer token (recommended in production)
YOOKASSA_WEBHOOK_TOKEN=

# ── Push notifications ────────────────────────────────────────────────────────
# Optional: push is gracefully disabled when these are absent
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# ── Maps & geocoding ──────────────────────────────────────────────────────────
YANDEX_GEOCODER_API_KEY=replace-with-yandex-geocoder-key
YANDEX_SUGGEST_API_KEY=replace-with-yandex-suggest-key
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Required for email OTP login and support ticket notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="МастерРядом <noreply@example.com>"
SUPPORT_TO=support@example.com
# Partnership inquiries from /partners. Falls back to SUPPORT_TO when unset.
SUPPORT_TO_PARTNERSHIP=partners@example.com
EMAIL_AUTH_ENABLED=false

# ── AI features ───────────────────────────────────────────────────────────────
# Master gate for the 4 chat surfaces (review-summary / review-reply /
# service-description / advisor) + visual search. When false, those routes
# return 503 gracefully — useful for dev without API keys.
AI_FEATURES_ENABLED=false
# Visual search still uses OpenAI directly (defer to post-launch — see
# docs/AI-MIGRATION-STRATEGY.md). Requires OPENAI_API_KEY regardless of
# AI_PROVIDER below.
VISUAL_SEARCH_ENABLED=false
OPENAI_API_KEY=

# ── AI provider (MIGRATION-STRATEGY 2026-05-30 — Phase 4a) ───────────────────
# Routes the 4 chat surfaces through one of two backends. Default `openai`
# preserves existing behaviour. Set to `yandex` to use Yandex Cloud's
# OpenAI-compatible endpoint (https://llm.api.cloud.yandex.net/v1) for
# native RU access without VPN/proxy. Reversible via env-toggle alone.
# AI_PROVIDER=openai
# AI_PROVIDER=yandex

# Required ONLY if AI_PROVIDER=yandex. Get values from Yandex Cloud console:
#   • YANDEX_API_KEY = service account API key, scope yc.ai.foundationModels.execute
#   • YANDEX_FOLDER_ID = folder identifier (used in model URI, format b1g...)
# Leave both blank otherwise.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── SMS provider (SMSC.ru — https://smsc.ru/api/) ────────────────────────────
# Real SMS delivery for OTP. When SMS_PROVIDER_ENABLED=false the app falls
# back to logging the OTP code into application logs (dev workflow). Set
# to true in prod + fill login/password. Optional `sender` overrides the
# default registered alpha-sender on your SMSC.ru account.
SMS_PROVIDER_ENABLED=false
SMS_PROVIDER_LOGIN=
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_SENDER=
# Low-balance alert threshold in RUB (used by future SMS-MONITORING-A cron).
SMS_LOW_BALANCE_THRESHOLD=500

# ── Monitoring ────────────────────────────────────────────────────────────────
# Optional: Telegram alerts for critical errors
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
