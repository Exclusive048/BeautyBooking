// === DOMAIN: Auth ===

model UserProfile {
  id String @id @default(cuid())

  roles AccountType[] @default([CLIENT])

  displayName String?

  phone String? @unique

  email String? @unique

  emailVerifiedAt DateTime?

  telegramId String? @unique

  telegramUsername String?

  externalPhotoUrl String?

  telegramLink TelegramLink?

  telegramLinkTokens TelegramLinkToken[]

  vkLink VkLink?

  yandexLink YandexLink?

  createdCategories GlobalCategory[] @relation("GlobalCategoryCreator")

  subscriptions        UserSubscription[]
  hotSlotSubscriptions HotSlotSubscription[]

  // NEW (optional profile fields)

  firstName String?

  lastName String?

  middleName String?

  birthDate DateTime?

  hideAgeYear Boolean @default(true)

  address String?

  geoLat Float?

  geoLng Float?

  publicUsername String? @unique

  publicUsernameUpdatedAt DateTime?

  providers Provider[] @relation("ProviderOwner")

  ownedStudios Studio[] @relation("StudioOwner")

  masterProfile MasterProfile?

  studioMemberships StudioMembership[]

  studioMembers StudioMember[]

  studioInvites StudioInvite[] @relation("StudioInvitedBy")

  bookings Booking[] @relation("BookingClient")

  // PACKAGE-BOOKING-MVP-1: packages this client booked.
  bookingPackages BookingPackage[] @relation("BookingPackageClient")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  refreshSessions   RefreshSession[]

  consents UserConsent[]

  mediaAssetsCreated MediaAsset[] @relation("MediaAssetCreatedBy")

  reviewsAuthored Review[] @relation("ReviewAuthor")

  favorites Favorite[]

  // Saved providers (catalog hearts) — separate from `favorites` which holds
  // portfolio-item bookmarks. See UserFavorite in favorite.prisma.
  providerFavorites UserFavorite[]

  modelApplications ModelApplication[]

  clientNotes ClientNote[] @relation("ClientNotesForClient")
  clientCards ClientCard[] @relation("ClientCardsForUser")

  publicUsernameAliases PublicUsernameAlias[] @relation("ClientPublicUsernameAliases")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  emailNotificationsEnabled Boolean @default(false)

  // FIX-EXP-NOTIFICATIONS (EXP-027): per-user push on/off preference. Opt-in
  // (default false) — set true only via an explicit user gesture (the push
  // toggle requests permission + subscribes). Gates delivery in sendPushToUser.
  pushNotificationsEnabled Boolean @default(false)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  /// Admin-imposed block. Behaviour gate (login refusal, mutation
  /// rejection) lands in a follow-up commit; this commit only adds
  /// the columns so we can reference them from `AdminAuditLog`.
  blockedAt DateTime?

  blockedByUserId String?

  blockedBy UserProfile? @relation("UserBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)

  blockedUsers UserProfile[] @relation("UserBlockedBy")

  blockedReason String?

  /// Audit-log rows authored by this user when acting as admin. The
  /// `onDelete: Restrict` on `AdminAuditLog.admin` means we cannot
  /// fully drop an admin account until their trail is reassigned.
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditLogActor")

  /// Reviews this user (acting as admin) soft-deleted. Backed by the
  /// optional `Review.deletedBy` relation added in the same commit.
  reviewsDeleted Review[] @relation("ReviewDeletedBy")

  @@index([blockedAt])
}

/// RKN-FIX-01: proof of consent per 152-ФЗ ст. 9 (ред. 156-ФЗ) — who agreed, to
/// which purpose, against which document VERSION, when, from where. Written
/// only by `src/lib/legal/consent.ts`.
model UserConsent {
  id String @id @default(cuid())

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  consentType ConsentType

  documentVersion String

  agreedAt DateTime @default(now())

  ipAddress String?

  userAgent String?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /// Version-scoped: one row per (user, purpose, document version). A version
  /// bump therefore yields a NEW row on the next login instead of overwriting
  /// the earlier proof — the history of "what was agreed to, and when" is the
  /// evidence. Repeat logins on an unchanged version write nothing.
  @@unique([userId, consentType, documentVersion])
  @@index([userId])
}

model OtpCode {
  id String @id @default(cuid())

  phone String?

  email String?

  channel OtpChannel @default(PHONE)

  codeHash String

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([expiresAt])
}

model RefreshSession {
  id String @id @default(cuid())

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  jti String @unique

  expiresAt DateTime

  usedAt DateTime?

  revokedAt DateTime?

  rotatedToSessionId String? @unique

  rotatedToSession RefreshSession? @relation("RefreshSessionRotation", fields: [rotatedToSessionId], references: [id], onDelete: SetNull)

  rotatedFromSession RefreshSession[] @relation("RefreshSessionRotation")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([usedAt])
}

model TelegramLink {
  id String @id @default(cuid())

  userId String @unique

  telegramUserId String?

  chatId String? @unique

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// RKN-FIX-12: identity link only — NO provider tokens are stored.
///
/// `accessToken`/`refreshToken` used to live here in plaintext. The audit found
/// them write-only: the profile fetch during the callback uses the FRESH token
/// from the code exchange (a local variable), `refreshVkToken` had zero callers,
/// and the single reader — a best-effort `logoutVkSession` on integration
/// disable — only existed to revoke the very token we were storing. Circular:
/// remove the storage and there is nothing left to revoke. Not storing a live
/// third-party credential beats encrypting one.
///
/// `deviceId` is retained: it is not a secret, and it is the VK-ID device
/// binding that a future refresh flow would need re-issued alongside a token.
model VkLink {
  id String @id @default(cuid())

  userId String @unique

  vkUserId String @unique

  deviceId String

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// FIX-YANDEX-OAUTH: Yandex ID auth link, bespoke-parallel to VkLink. No
// deviceId (Yandex OAuth2 has none). isEnabled kept for parity.
/// RKN-FIX-12: identity link only — NO provider tokens are stored (same
/// reasoning as VkLink above; Yandex tokens had zero read sites at all, and
/// there is no Yandex refresh/logout helper in the codebase).
model YandexLink {
  id String @id @default(cuid())

  userId String @unique

  yandexUserId String @unique

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PublicUsernameAlias {
  id String @id @default(cuid())

  username String @unique

  providerId String?

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  clientUserId String?

  clientUser UserProfile? @relation("ClientPublicUsernameAliases", fields: [clientUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([providerId])
  @@index([clientUserId])
}
