// === DOMAIN: Auth ===

model UserProfile {
  id String @id @default(cuid())

  roles AccountType[] @default([CLIENT])

  displayName String?

  phone String? @unique

  // PHONE-CLAIM-01: зеркало email-модели (инв. #41) для телефона. «Заявить»
  // номер может любой аутентифицированный пользователь из кабинета (SMS-шлюза
  // нет, доказать владение нечем), «владеть» — только доказавший через
  // phone-OTP. Любая запись phone вне OTP-verify обязана оставлять
  // phoneVerifiedAt = null; все места, где телефон работает ключом матчинга
  // (phone-OTP-вход, гостевые брони, студийные инвайты, бейдж/центр
  // уведомлений), принимают ТОЛЬКО подтверждённый номер либо guest-class
  // профиль — иначе заявка чужого номера = перехват гостевых броней/инвайтов
  // (SECURITY-EXPOSURE-AUDIT-01 #2). Уникальность phone остаётся ПОЛНОЙ (в
  // отличие от email): заявка занимает слот, но отпускается доказательством
  // (releaseUnverifiedPhoneClaims) — см. src/lib/auth/phone-claim.ts.
  phoneVerifiedAt DateTime?

  // EMAIL-ADDRESS-OCCUPATION: уникальность email — ЧАСТИЧНАЯ, только по
  // подтверждённым адресам (`WHERE "emailVerifiedAt" IS NOT NULL`, сырой SQL,
  // реестр `scripts/raw-sql-objects.mjs`). Полный @@unique здесь означал бы,
  // что ЛЮБАЯ неподтверждённая запись чужого адреса занимает его навсегда:
  // владелец при регистрации упирался в P2002 и получал «Обратитесь в
  // поддержку» на единственном включённом в проде канале входа. Теперь
  // «заявить» адрес может кто угодно и сколько угодно, а «владеть» им —
  // ровно один, и владение даёт только доказательство (инв. #41).
  email String?

  emailVerifiedAt DateTime?

  telegramId String? @unique

  telegramUsername String?

  externalPhotoUrl String?

  telegramLink TelegramLink?

  telegramLinkTokens TelegramLinkToken[]

  vkLink VkLink?

  yandexLink YandexLink?

  createdCategories GlobalCategory[] @relation("GlobalCategoryCreator")

  subscriptions        UserSubscription[]
  hotSlotSubscriptions HotSlotSubscription[]

  // NEW (optional profile fields)

  firstName String?

  lastName String?

  middleName String?

  birthDate DateTime?

  hideAgeYear Boolean @default(true)

  address String?

  geoLat Float?

  geoLng Float?

  publicUsername String? @unique

  publicUsernameUpdatedAt DateTime?

  providers Provider[] @relation("ProviderOwner")

  ownedStudios Studio[] @relation("StudioOwner")

  masterProfile MasterProfile?

  studioMemberships StudioMembership[]

  studioMembers StudioMember[]

  studioInvites StudioInvite[] @relation("StudioInvitedBy")

  bookings Booking[] @relation("BookingClient")

  // PACKAGE-BOOKING-MVP-1: packages this client booked.
  bookingPackages BookingPackage[] @relation("BookingPackageClient")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  refreshSessions   RefreshSession[]

  consents UserConsent[]

  mediaAssetsCreated MediaAsset[] @relation("MediaAssetCreatedBy")

  reviewsAuthored Review[] @relation("ReviewAuthor")

  favorites Favorite[]

  // Saved providers (catalog hearts) — separate from `favorites` which holds
  // portfolio-item bookmarks. See UserFavorite in favorite.prisma.
  providerFavorites UserFavorite[]

  modelApplications ModelApplication[]

  clientNotes ClientNote[] @relation("ClientNotesForClient")
  clientCards ClientCard[] @relation("ClientCardsForUser")

  publicUsernameAliases PublicUsernameAlias[] @relation("ClientPublicUsernameAliases")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  emailNotificationsEnabled Boolean @default(false)

  // FIX-EXP-NOTIFICATIONS (EXP-027): per-user push on/off preference. Opt-in
  // (default false) — set true only via an explicit user gesture (the push
  // toggle requests permission + subscribes). Gates delivery in sendPushToUser.
  pushNotificationsEnabled Boolean @default(false)

  // WELCOME-DIALOG-01: когда человек закрыл приветствие этапа тестирования.
  // `null` — ещё не видел: окно показывается один раз после регистрации, пока
  // включён флаг `welcomeDialogEnabled`. Существующим аккаунтам миграция
  // проставила дату — окно только для новых регистраций.
  welcomeSeenAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  /// Admin-imposed block. Behaviour gate (login refusal, mutation
  /// rejection) lands in a follow-up commit; this commit only adds
  /// the columns so we can reference them from `AdminAuditLog`.
  blockedAt DateTime?

  blockedByUserId String?

  blockedBy UserProfile? @relation("UserBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)

  blockedUsers UserProfile[] @relation("UserBlockedBy")

  blockedReason String?

  /// Audit-log rows authored by this user when acting as admin. The
  /// `onDelete: Restrict` on `AdminAuditLog.admin` means we cannot
  /// fully drop an admin account until their trail is reassigned.
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditLogActor")

  /// RKN-FIX-10: массовые чтения ПДн, выполненные этим пользователем.
  pdAccessLogs PdAccessLog[] @relation("PdAccessLogActor")

  /// Reviews this user (acting as admin) soft-deleted. Backed by the
  /// optional `Review.deletedBy` relation added in the same commit.
  reviewsDeleted Review[] @relation("ReviewDeletedBy")

  @@index([blockedAt])
}

/// RKN-FIX-01: proof of consent per 152-ФЗ ст. 9 (ред. 156-ФЗ) — who agreed, to
/// which purpose, against which document VERSION, when, from where. Written
/// only by `src/lib/legal/consent.ts`.
model UserConsent {
  id String @id @default(cuid())

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  consentType ConsentType

  documentVersion String

  agreedAt DateTime @default(now())

  ipAddress String?

  userAgent String?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /// RKN-FIX-18 — уникальность СНЯТА со схемы и заменена на **partial unique
  /// index в сыром SQL**: `UNIQUE (userId, consentType, documentVersion)
  /// WHERE "revokedAt" IS NULL` (миграция `20260803..._rkn_fix_18_consent_withdrawal`,
  /// реестр `scripts/raw-sql-objects.mjs`).
  ///
  /// Почему. Прежний полный `@@unique` разрешал ровно одну строку на версию
  /// документа — и это заставляло повторное согласие ОЖИВЛЯТЬ отозванную
  /// строку (revokedAt=null + свежий agreedAt). Оживление стирало историю:
  /// исходная дата согласия и сам факт отзыва исчезали из доказательной базы,
  /// хотя именно они и есть предмет доказывания.
  ///
  /// Теперь: строки НИКОГДА не оживляются. Отзыв проставляет `revokedAt`
  /// (строка остаётся), повторное согласие вставляет НОВУЮ строку. Partial
  /// unique гарантирует на уровне БД «не более одной АКТИВНОЙ строки на
  /// (user, purpose, version)», а исторических (отозванных) может быть сколько
  /// угодно — таймлайн «согласился → отозвал → согласился снова»
  /// восстанавливается полностью.
  ///
  /// Prisma partial unique не выражает — отсюда сырой SQL и запись в реестре.
  @@index([userId, consentType, documentVersion])
  @@index([userId])
}

model OtpCode {
  id String @id @default(cuid())

  phone String?

  email String?

  channel OtpChannel @default(PHONE)

  codeHash String

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([expiresAt])
}

model RefreshSession {
  id String @id @default(cuid())

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  jti String @unique

  expiresAt DateTime

  usedAt DateTime?

  revokedAt DateTime?

  rotatedToSessionId String? @unique

  /// SEC-13: идентификатор «семьи» сессий — одно устройство/вход. Ротация
  /// создаёт новую строку, но familyId наследуется, поэтому access-токен
  /// можно привязать к семье, а не к конкретной строке (иначе каждая ротация
  /// обнуляла бы живой access-токен). Nullable: строки, выпущенные до
  /// миграции, семьи не имеют и трактуются как legacy.
  familyId String?

  rotatedToSession RefreshSession? @relation("RefreshSessionRotation", fields: [rotatedToSessionId], references: [id], onDelete: SetNull)

  rotatedFromSession RefreshSession[] @relation("RefreshSessionRotation")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([usedAt])
  // SEC-13: проверка «жива ли семья» идёт на КАЖДЫЙ аутентифицированный
  // запрос — она обязана попадать в индекс.
  @@index([userId, familyId, revokedAt])
}

model TelegramLink {
  id String @id @default(cuid())

  userId String @unique

  telegramUserId String?

  chatId String? @unique

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// RKN-FIX-12: identity link only — NO provider tokens are stored.
///
/// `accessToken`/`refreshToken` used to live here in plaintext. The audit found
/// them write-only: the profile fetch during the callback uses the FRESH token
/// from the code exchange (a local variable), `refreshVkToken` had zero callers,
/// and the single reader — a best-effort `logoutVkSession` on integration
/// disable — only existed to revoke the very token we were storing. Circular:
/// remove the storage and there is nothing left to revoke. Not storing a live
/// third-party credential beats encrypting one.
///
/// `deviceId` is retained: it is not a secret, and it is the VK-ID device
/// binding that a future refresh flow would need re-issued alongside a token.
model VkLink {
  id String @id @default(cuid())

  userId String @unique

  vkUserId String @unique

  deviceId String

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// FIX-YANDEX-OAUTH: Yandex ID auth link, bespoke-parallel to VkLink. No
// deviceId (Yandex OAuth2 has none). isEnabled kept for parity.
/// RKN-FIX-12: identity link only — NO provider tokens are stored (same
/// reasoning as VkLink above; Yandex tokens had zero read sites at all, and
/// there is no Yandex refresh/logout helper in the codebase).
model YandexLink {
  id String @id @default(cuid())

  userId String @unique

  yandexUserId String @unique

  isEnabled Boolean @default(true)

  linkedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PublicUsernameAlias {
  id String @id @default(cuid())

  username String @unique

  providerId String?

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  clientUserId String?

  clientUser UserProfile? @relation("ClientPublicUsernameAliases", fields: [clientUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([providerId])
  @@index([clientUserId])
}
