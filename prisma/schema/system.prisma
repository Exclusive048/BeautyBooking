// === DOMAIN: System ===

model AppSetting {
  key String @id

  value String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SystemConfig {
  key String @id

  value Json

  updatedAt DateTime @updatedAt
}

/// FIX-B16 — денежный потолок платных AI-вызовов (Yandex Foundation Models).
///
/// Счётчик живёт в Postgres, а не в Redis, по одной причине: потолок, который
/// обнуляется рестартом процесса, потолком не является. Redis-версия (SEC-04)
/// при недоступности кэша уходила в memory-fallback — то есть суточный лимит
/// умножался на число процессов и обнулялся каждым деплоем.
///
/// Разделение политик осознанное и НЕ отменяет SEC-04: частотный лимит
/// (3/60с на IP) по-прежнему деградирует при обрыве Redis — его отказ стоит
/// лишних запросов. Денежный потолок деградировать не может: его отказ стоит
/// неограниченных денег.
model AiSpendCounter {
  /// Ключ поверхности — член `AI_SPEND_CEILINGS` (`src/lib/ai/spend-ceiling.ts`).
  meter String

  /// UTC-сутки `YYYY-MM-DD`. Источник времени — **UTC-tech** (rule 17):
  /// счётчик инстансовый, пользовательского времени в нём нет.
  dayKey String

  /// Число ПЛАТНЫХ ВЫЗОВОВ, не запросов: один поиск по фото — это 2 vision +
  /// 1 embedding, и деньги считаются по вызовам. Растёт и на отказанных
  /// попытках (инкремент атомарен и идёт до сравнения с потолком) — отказ
  /// стоит одного UPDATE и ноль рублей.
  count Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now())

  @@id([meter, dayKey])
}
