// === DOMAIN: Booking ===

model Booking {
  id String @id @default(cuid())

  providerId String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  masterProviderId String?

  masterProvider Provider? @relation("BookingMaster", fields: [masterProviderId], references: [id], onDelete: SetNull)

  clientUserId String?

  clientUser UserProfile? @relation("BookingClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  // UTC instants only — ЕДИНСТВЕННЫЙ источник времени брони (инв. #1, rule 8).
  //
  // BOOKING-TIME-COLUMNS-01 (2026-08-03): здесь же лежала legacy-пара
  // `startAt`/`endAt`, дублировавшая эти колонки. Она удалена. Аудит показал,
  // что разойтись пары не могли — КАЖДЫЙ из 9 write-путей писал обе из одного
  // выражения, — а функциональных читателей у legacy не было вообще (один
  // мёртвый select). Сиды не заполняли её уже давно: 101 из 167 строк имели
  // `startAt = NULL` без единого последствия. Ноль расхождений в значениях.
  //
  // ⚠️ НЕ путать с тремя другими парами: `TimeBlock.startAt/endAt` и
  // `ScheduleBreak.endAt` — их СОБСТВЕННЫЕ канонические поля (Utc-близнецов
  // нет), а `Booking.proposedStartAt/proposedEndAt` — предложение переноса,
  // отдельная сущность.

  startAtUtc DateTime?

  endAtUtc DateTime?

  studioId String?

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  masterId String?

  clientId String?

  slotLabel String

  clientName String

  clientPhone String

  clientNameSnapshot String?

  clientPhoneSnapshot String?

  comment String?

  source BookingSource @default(MANUAL)

  notes String?

  silentMode Boolean @default(false)

  referencePhotoAssetId String?

  bookingAnswers Json?

  referencePhoto MediaAsset? @relation("BookingReferencePhoto", fields: [referencePhotoAssetId], references: [id])

  status BookingStatus @default(PENDING)

  cancelledBy BookingCancelledBy?

  cancelReason String?

  cancelledAtUtc DateTime?

  proposedStartAt DateTime?

  proposedEndAt DateTime?

  requestedBy BookingRequestedBy?

  changeComment String?

  actionRequiredBy BookingActionRequiredBy?

  clientChangeRequestsCount Int @default(0)

  masterChangeRequestsCount Int @default(0)

  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  notifications Notification[]

  chat BookingChat?

  review Review?

  serviceItems BookingServiceItem[]

  // PACKAGE-BOOKING-MVP-1: when set, this Booking is one component of an
  // atomically-created service package. The child stays a normal independent
  // Booking (own reschedule path); the group id lets cancel-whole + analytics
  // treat the package as a unit. SetNull so deleting the package row never
  // orphan-deletes a real booking.
  bookingPackageId String?

  bookingPackage BookingPackage? @relation(fields: [bookingPackageId], references: [id], onDelete: SetNull)

  modelApplication ModelApplication? @relation("ModelApplicationBooking")

  // Cards rendered inline in chat threads reference this booking. Plural —
  // a booking can collect several system messages (created → confirmed →
  // rescheduled). See ChatMessage.referencedBookingId.
  chatMessageReferences ChatMessage[] @relation("ChatMessageBooking")

  @@index([providerId, startAtUtc, endAtUtc])
  @@index([providerId])
  @@index([masterProviderId])
  @@index([startAtUtc])
  @@index([serviceId])
  @@index([clientUserId])
  @@index([studioId])
  @@index([masterId])
  @@index([status, startAtUtc])
  // PERF-09 (I-1). Канбан мастера фильтрует по `masterProviderId` + окну
  // `startAtUtc` и сортирует по `startAtUtc`. Зеркало для `providerId` есть
  // (`[providerId, startAtUtc, endAtUtc]` выше), а для исполнителя не было —
  // при том, что `masterPerformedBookingWhere` даёт OR по ОБОИМ, то есть одна
  // ветвь OR шла по индексу, а вторая тянула всю историю мастера и
  // сортировала её в памяти.
  @@index([masterProviderId, startAtUtc])
  // PERF-09 (I-2). «Мои записи» клиента: `where { clientUserId }` +
  // `orderBy startAtUtc desc` + `take 300`. Без порядка в индексе `take` не
  // спасает — сортируется весь набор клиента.
  @@index([clientUserId, startAtUtc(sort: Desc)])
  // PERF-09 (I-3). Клиенты студии: тот же разрыв, что I-1, для арендатора.
  @@index([studioId, startAtUtc(sort: Desc)])
  @@index([bookingPackageId])
}

model BookingServiceItem {
  id String @id @default(cuid())

  bookingId String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  studioId String?

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  serviceId String?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  titleSnapshot String

  priceSnapshot Int

  durationSnapshotMin Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([studioId])
  @@index([serviceId])
}

/// PACKAGE-BOOKING-MVP-1 — groups the N child Bookings created atomically
/// from a ServicePackage. Money lives in each child `BookingServiceItem`
/// (proportional discounted `priceSnapshot`); `totalKopeks` snapshots the
/// sum so analytics + cancel-whole have a single authoritative total. The
/// package + its discount config are snapshotted (servicePackageId is
/// SetNull) so editing/deleting the source package never mutates booked
/// money.
model BookingPackage {
  id String @id @default(cuid())

  servicePackageId String?

  servicePackage ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)

  providerId String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  clientUserId String?

  clientUser UserProfile? @relation("BookingPackageClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  /// Snapshot of the source package discount (reuses DiscountType enum).
  discountType DiscountType @default(PERCENT)

  discountValue Int @default(0)

  /// Σ of the child BookingServiceItem.priceSnapshot (kopeks) == final price.
  totalKopeks Int @default(0)

  status BookingPackageStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([providerId])
  @@index([clientUserId])
  @@index([servicePackageId])
}

model BookingChat {
  id String @id @default(cuid())

  bookingId String @unique

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model ChatMessage {
  id String @id @default(cuid())

  chatId String

  chat BookingChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderType ChatSenderType

  senderName String

  body String @db.Text

  readAt DateTime?

  // CHAT-FOUNDATION-A-MIGRATION: optional image attachment per chat
  // message. Mirrors the booking-reference upload pattern — the
  // asset is owner-scoped via `MediaAsset.createdByUserId`, lives
  // under `kind=CHAT_ATTACHMENT` + `entityType=CHAT_MESSAGE`, and
  // gets re-pointed from `pending:<userId>` to `chat-message:<msgId>`
  // when the link is persisted (marks it used so the same asset
  // can't be reattached to a second message).
  attachmentMediaAssetId String?

  attachmentMediaAsset MediaAsset? @relation("ChatMessageAttachment", fields: [attachmentMediaAssetId], references: [id], onDelete: SetNull)

  // System messages can pin a booking card (status change, reschedule, etc.).
  // Cascade is SetNull so deleting a booking just unlinks the card — message
  // stays in the chat as plain text for audit-trail purposes.
  referencedBookingId String?

  referencedBooking Booking? @relation("ChatMessageBooking", fields: [referencedBookingId], references: [id], onDelete: SetNull)

  /**
   * Lifecycle event identifier for system messages (e.g. BOOKING_CONFIRMED,
   * BOOKING_RESCHEDULED). Used together with referencedBookingId for idempotent
   * inserts — emit-once per (bookingId, eventKey). Free-text for now; if
   * we need stricter enforcement promote to an enum.
   */
  systemEventKey String?

  createdAt DateTime @default(now())

  @@unique([referencedBookingId, systemEventKey])
  @@index([chatId, createdAt])
  @@index([chatId, readAt])
  @@index([referencedBookingId])
  @@index([attachmentMediaAssetId])
}

// chat-url-fix: opaque public identifier for (provider, client) chat
// pair. Replaces the prior `providerId:clientUserId` key that leaked
// internal CUIDs into URLs and notification payloads. Slug is
// generated lazily on first conversation access by
// `getOrCreateConversationSlug` and stays stable for the pair's
// lifetime. Access is still gated by `resolveConversationAccess`
// (pair-ownership in Booking) — slug is identifier, not auth token.
model ConversationSlug {
  id String @id @default(cuid())

  slug String @unique

  providerId String

  clientUserId String

  createdAt DateTime @default(now())

  @@unique([providerId, clientUserId])
  @@index([slug])
}
