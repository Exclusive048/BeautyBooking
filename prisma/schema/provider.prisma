// === DOMAIN: Provider ===

model Provider {
  id String @id @default(cuid())

  type ProviderType

  name String

  tagline String

  rating Float @default(0)

  reviews Int @default(0)

  ratingAvg Float @default(0)

  ratingCount Int @default(0)

  priceFrom Int @default(0)

  address String

  district String

  // City link — populated automatically by detect-city when address is saved.
  // null while no address has been geocoded; required for `isPublished: true`
  // (gated in setProviderPublished).
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  categories String[] @default([])

  availableToday Boolean @default(false)

  // CATALOG-DATE-TIME-FILTER (2026-09-24) — снимок свободного времени на
  // ближайшие дни для фильтра каталога «когда»: ключи дня салона
  // `YYYY-MM-DD` (есть свободное окошко в этот день) и часа `YYYY-MM-DDTHH`
  // (окошко начинается в этот час). Пишет только воркер
  // (`schedule/free-slot-keys.ts`, вместе с `availableToday`); каталог
  // фильтрует по нему `has`/`hasSome`, не запуская движок расписания.
  freeSlotKeys String[] @default([])

  // FIX-R2-02-A — platform default aligned with City.timezone default +
  // env.DEFAULT_TIMEZONE (resolves the long-standing T4 Asia/Almaty mismatch).
  // The working tz is re-derived from the provider's City on address-save.
  timezone String @default("Europe/Moscow")

  bufferBetweenBookingsMin Int @default(0)

  autoConfirmBookings       Boolean      @default(false)
  autoPublishStoriesEnabled Boolean      @default(true)
  cancellationDeadlineHours Int?
  remindersEnabled          Boolean      @default(true)
  scheduleMode              ScheduleMode @default(FLEXIBLE)
  fixedSlotTimes            String[]     @default([])

  // Booking-rules & visibility settings (25-SETTINGS-B). Surfaced in the
  // master cabinet under Settings → "Правила" / "Видимость"; persisted via
  // the same PATCH endpoint as the week schedule. `lateCancelAction` is
  // stored but not yet enforced — payment-side fines aren't wired.
  // `slotPrecision` controls how slots are surfaced on the public profile.
  minBookingHoursAhead Int     @default(2)
  maxBookingDaysAhead  Int     @default(90)
  lateCancelAction     String  @default("none")
  slotPrecision        String  @default("exact")
  visibleSlotDays      Int     @default(30)
  acceptNewClients     Boolean @default(true)
  // Booking grid quantum (15 / 30 / 60 min). Surfaced in Settings → "Часы";
  // persisted via PATCH /api/cabinet/master/schedule. Existing rows get 15
  // by default — matches the prior implicit behaviour.
  slotStepMin               Int          @default(15)

  studioId String?

  studio Provider? @relation("StudioMasters", fields: [studioId], references: [id], onDelete: SetNull)

  masters Provider[] @relation("StudioMasters")

  // NEW (optional business contact + publish + geo)

  contactName String?

  contactPhone String?

  contactEmail String?

  // FEAT-PROVIDER-SOCIALS: free-text VK / Instagram community-page links
  // (NOT OAuth account links — those live on UserProfile.vkLink/telegramLink).
  // Stored as a normalized, safe `https://<host>/<handle>` URL or null.
  // Normalization + host/scheme validation: src/lib/providers/social-links.ts.
  socialVk        String?
  socialInstagram String?

  description String?

  avatarUrl String?

  geoLat Float?

  geoLng Float?

  isPublished Boolean @default(false)

  // STUDIO-PAUSE-SPLIT-01 (2026-09-23): пауза мастера В СТУДИИ (ставит админ
  // студии). Отдельно от `isPublished` — тот теперь только личная видимость
  // мастера: пауза в студии не гасит его личную страницу и собственные услуги.
  // «Активен в студии» = `ownerUserId != null && !studioPaused`
  // (`lib/studio/master-eligibility.ts`, инв. #24).
  studioPaused Boolean @default(false)

  // SETUP-GUIDE-01 (2026-09-28): «Первые шаги» кабинета. Остальные шаги
  // отмечаются сами по данным (`lib/onboarding/setup-guide.ts`); у правил
  // записи есть значения по умолчанию, поэтому их просмотр подтверждают явно.
  // `setupGuideHiddenAt` — человек скрыл карточку на главной.
  setupRulesConfirmedAt DateTime?
  setupGuideHiddenAt    DateTime?

  publicUsername String? @unique

  publicUsernameUpdatedAt DateTime?

  ownerUserId String?

  owner UserProfile? @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  services Service[]

  // LOGIC-19: блоки времени этого мастера (обратная сторона `TimeBlock.masterProvider`).
  masterTimeBlocks TimeBlock[] @relation("ProviderTimeBlocks")

  masterServices MasterService[] @relation("MasterServices")

  servicePackages ServicePackage[] @relation("MasterServicePackages")

  // PACKAGE-BOOKING-MVP-1: packages booked at this provider.
  bookingPackages BookingPackage[]

  bookings Booking[]

  masterBookings Booking[] @relation("BookingMaster")

  scheduleOverrides ScheduleOverride[]

  scheduleBreaks ScheduleBreak[]

  scheduleTemplates ScheduleTemplate[]

  weeklyScheduleConfig WeeklyScheduleConfig?

  schedulePatterns SchedulePattern[]

  scheduleChangeRequests ScheduleChangeRequest[]

  discountRule DiscountRule?

  hotSlots             HotSlot[]
  hotSlotSubscriptions HotSlotSubscription[]
  favoritedBy          UserFavorite[]

  studioProfile Studio? @relation("StudioProvider")

  masterProfile MasterProfile? @relation("MasterProvider")

  reviewsAbout Review[]

  portfolioItems PortfolioItem[] @relation("PortfolioItemOwner")

  performedPortfolioItems PortfolioItem[] @relation("PortfolioItemPerformer")

  publicUsernameAliases PublicUsernameAlias[]

  createdGlobalCategories GlobalCategory[] @relation("GlobalCategoryCreatorProvider")

  modelOffers ModelOffer[]

  clientNotes ClientNote[] @relation("ClientNotesForMaster")

  clientCards ClientCard[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([studioId])
  @@index([isPublished, rating(sort: Desc), reviews(sort: Desc)])
  @@index([isPublished, ratingAvg(sort: Desc), reviews(sort: Desc), createdAt(sort: Desc)])
  @@index([studioId, type, isPublished, createdAt])
  @@index([type, isPublished, address])
  @@index([isPublished, autoPublishStoriesEnabled])
  @@index([cityId, isPublished])
  // PERF-09 (I-6). С выбранным городом (дефолт UI) сортировочный индекс
  // `[isPublished, ratingAvg, reviews, createdAt]` перестаёт покрывать
  // `orderBy`: остаётся `(cityId, isPublished)` плюс внешняя сортировка. Этот
  // повторяет BASE_ORDER каталога целиком, с городом впереди.
  @@index([cityId, isPublished, ratingAvg(sort: Desc), reviews(sort: Desc), createdAt(sort: Desc)])
}

model MasterProfile {
  id String @id @default(cuid())

  userId String @unique

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String @unique

  provider Provider @relation("MasterProvider", fields: [providerId], references: [id], onDelete: Cascade)

  lastBookingsSeenAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Studio {
  id String @id @default(cuid())

  providerId String @unique

  provider Provider @relation("StudioProvider", fields: [providerId], references: [id], onDelete: Cascade)

  ownerUserId String?

  owner UserProfile? @relation("StudioOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  memberships StudioMembership[]

  studioMembers StudioMember[]

  invites StudioInvite[]

  ratingAvg Float @default(0)

  ratingCount Int @default(0)

  serviceCategories ServiceCategory[]

  masterServices MasterService[]

  timeBlocks TimeBlock[]

  scheduleRequests ScheduleChangeRequest[]

  services Service[]

  bookings Booking[]

  portfolioItems PortfolioItem[]

  reviews Review[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model StudioMember {
  id String @id @default(cuid())

  studioId String

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  role StudioMemberRole

  status StudioMemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studioId, userId, role])
  @@index([userId, status])
  @@index([studioId, status])
}

model StudioMembership {
  id String @id @default(cuid())

  userId String

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  studioId String

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  roles StudioRole[]

  status MembershipStatus @default(PENDING)

  leftAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, studioId])
  @@index([userId])
  @@index([studioId])
  @@index([status])
}

model StudioInvite {
  id String @id @default(cuid())

  studioId String

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // STUDIO-INVITE-EMAIL-01: приглашение адресуется телефону ИЛИ почте (ровно
  // одному из двух — проверяет схема создания `createStudioMasterSchema`).
  // Почта хранится в нижнем регистре; право на приглашение по почте даёт
  // только ПОДТВЕРЖДЁННЫЙ адрес (`emailVerifiedAt`, инв. #41), по телефону —
  // подтверждённый номер (инв. #46) либо грант администратора своей студии.
  phone String?

  email String?

  status MembershipStatus @default(PENDING)

  invitedByUserId String

  invitedBy UserProfile @relation("StudioInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studioId, phone])
  @@unique([studioId, email])
  @@index([studioId])
  @@index([phone])
  @@index([email])
  @@index([status])
}
