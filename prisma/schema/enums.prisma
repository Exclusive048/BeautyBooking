/// MOBILE-B2 — через какой сервис доставляется push нативного приложения:
/// FCM (Android с Google-сервисами), APNs (iOS), RuStore Push (Android без
/// Google-сервисов). Строка `MobilePushDevice` — одна установка приложения.
enum MobilePushProvider {
  FCM

  APNS

  RUSTORE
}

/// MOBILE-B2 — окружение APNs, которому выдан токен устройства: сборка из
/// Xcode / TestFlight-отладки получает токен SANDBOX, App Store — PRODUCTION.
/// Токен одного окружения на хосте другого — `BadDeviceToken`.
enum MobilePushApnsEnvironment {
  SANDBOX

  PRODUCTION
}

