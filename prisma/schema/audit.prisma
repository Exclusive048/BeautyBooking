// === DOMAIN: Admin Audit ===
//
// Single audit log for every privileged admin action. Replaces the
// `logInfo("admin.*", ...)` patchwork that grew through Phase 2 by
// giving us a queryable history with FK-enforced links to the actor
// (`admin`) and (where relevant) the target row.
//
// The existing `BillingAuditLog` (see billing.prisma) is **not**
// removed here — its retirement is a separate decision tracked in
// ADMIN-AUDIT-INTEGRATION. Until then both tables coexist.

model AdminAuditLog {
  id String @id @default(cuid())

  adminUserId String

  // Restrict: we never want to drop an admin user while their audit
  // trail still references them. If the account is ever fully removed
  // its rows must be reassigned or migrated explicitly first.
  admin UserProfile @relation("AdminAuditLogActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  action AdminAuditAction

  /// Free-form discriminator: "user" / "review" / "city" / "plan" /
  /// "subscription" / "payment" / "category" / "setting" / null.
  /// Indexed together with `targetId` for fast per-entity lookups.
  targetType String?

  targetId String?

  /// Structured detail blob — typically `{ diff: { before, after } }`
  /// for state changes, or action-specific context (e.g. plan code,
  /// flag key, refund amount). Schema is enforced at the call site,
  /// not at the DB layer.
  details Json?

  /// Optional admin-supplied free text (e.g. cancel reason, delete
  /// reason). Surfaced in UI; not used for branching logic.
  reason String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// === DOMAIN: PD access trail (RKN-FIX-10) ===
//
// 152-ФЗ ст. 21 ч. 3.1 даёт 24 часа на уведомление РКН об инциденте и 72 на
// результаты расследования. Мутации у нас аудируются (инв. #16/#18/#19),
// auth-события логируются — а **массовые чтения невидимы**: скомпрометированный
// аккаунт мог пролистать всю клиентскую базу, и через сутки нечем ответить на
// вопрос «чьи данные утекли и сколько».
//
// Назначение этой таблицы — **scoping**, а не детект. Она отвечает ровно на
// один вопрос: «что читал актор X в окне Y». Пороги и алерты на аномальный
// объём — отдельная задача (BACKLOG), сознательно вне RKN-FIX-10.
//
// 🔴 Тут НЕТ прочитанных данных. Только личность актора, форма запроса и
// счётчик. Иначе журнал защиты ПДн сам стал бы второй копией этих ПДн —
// удвоив, а не сузив поверхность утечки.
model PdAccessLog {
  id String @id @default(cuid())

  /// Nullable: SYSTEM-акторы (cron/worker) не имеют профиля, а при удалении
  /// аккаунта ссылка обнуляется (SetNull) — след инцидента переживает
  /// удаление, привязка к удалённому человеку — нет. См. карту диспозиций.
  actorUserId String?

  actor UserProfile? @relation("PdAccessLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorType PdAccessActorType

  /// Стабильный ключ поверхности: "admin.users.list", "master.clients.list", …
  /// Именно ключ, а не URL — путь меняется при рефакторе, вопрос «что читали»
  /// не меняется.
  surface String

  /// Какая сущность перечислялась: "UserProfile" / "Booking" / "ClientCard" / …
  entityType String

  /// Сколько строк ушло в ответе. Одно событие на ответ, не на строку.
  rowCount Int

  /// ФОРМА запроса (нормализованные имена фильтров + признак наличия поиска),
  /// НИКОГДА не значения и не результат: по ней видно «листали всё» против
  /// «искали одного», и при этом сама она не является ПДн.
  filterFingerprint String?

  /// Арендатор, в чьих данных читали, — чтобы при инциденте у провайдера
  /// сузить выборку без джойнов.
  scopeProviderId String?

  scopeStudioId String?

  requestId String?

  ipAddress String?

  createdAt DateTime @default(now())

  /// Главный индекс — под вопрос инцидента «что читал актор X в окне Y».
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([surface, createdAt(sort: Desc)])
  @@index([scopeProviderId, createdAt(sort: Desc)])
}
