# ─────────────────────────────────────────────────────────────────────────────
# Production environment — copy to .env.production and fill in real values.
# Never commit the real .env.production to git.
#
# Docker-compose reads this file via (APP-TIER-SPLIT-02: профили app / db,
# см. шапку docker-compose.prod.yml — ВМ приложения и хост БД):
#   docker compose --env-file .env.production -f docker-compose.prod.yml --profile app up -d
#
# Synced to src/lib/env.ts schema by PROD-ENV-EXAMPLE-SYNC-A (2026-05-23 —
# closes DR-1 from DEPLOYMENT-READINESS-AUDIT-A). When env.ts changes,
# update this template alongside .env.example (per SPRINT-PATTERNS Pattern 5:
# sync ALL examples — dev AND prod — to avoid silent prod regressions).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Used by docker-compose postgres service and the app/worker containers.
# Production hosting TBD (pending DevOps decision — managed Postgres OR self-hosted).
# pgvector extension required (used for visual-search embeddings via MediaAssetEmbedding).
POSTGRES_DB=masterryadom
POSTGRES_USER=masterryadom
POSTGRES_PASSWORD=replace-with-strong-password

# Prisma connection URL. Боевой стенд: Postgres — профиль `db` на ОТДЕЛЬНОМ хосте,
# порт 5861 в приватной сети → host=<приватный IP хоста БД>:5861. host=postgres:5432 —
# только если профили app и db подняты на одной машине.
# for managed Postgres (Yandex Managed PostgreSQL OR equivalent — DevOps decision) use the provider-issued host.
# Note: Supabase not used (РФ accessibility); choose provider that's reachable from production VM.
# RES-24: the app appends `options=-c statement_timeout=30000` itself (src/lib/prisma-datasource.ts),
# so a pathological query cannot hold a pool slot forever. Set `options=` here ONLY to override that
# bound — an explicit `options` in the URL is left untouched. Do NOT put statement_timeout in the URL
# "for migrations too": `prisma migrate deploy` reads this same URL and FK/CHECK validation on a large
# table is legitimately slow. Pool sizing (`connection_limit` vs Postgres max_connections) is a topology
# decision — see DEPLOY-BACKLOG.md.
DATABASE_URL=postgresql://masterryadom:replace-with-strong-password@postgres:5432/masterryadom?schema=public

# Prisma direct URL — used by `prisma migrate deploy` to bypass pgbouncer if present.
# If you are NOT using pgbouncer, set this to the same value as DATABASE_URL.
DIRECT_URL=postgresql://masterryadom:replace-with-strong-password@postgres:5432/masterryadom?schema=public

# ── Edge / TLS — traefik из docker-compose.prod.yml (профиль app) ─────────────
# Почта регистрации Let's Encrypt. traefik терминирует TLS для masterryadom.ru
# (HTTP-01 на :80) и делит трафик: /api/* → api, остальное → web.
TRAEFIK_ACME_EMAIL=admin@masterryadom.ru

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379
# Optional connection/command timeouts (ms). Defaults applied when unset.
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=replace-with-64-char-random-secret
OTP_HMAC_SECRET=replace-with-separate-64-char-random-secret
AUTH_COOKIE_NAME=bh_session

# 🚩 AUTH-GATE-01 → ENV-SPLIT-01 (2026-08-30): флаг PHONE_AUTH_ENABLED УДАЛЁН.
# Вход по телефону в production включён РОВНО тогда, когда настроен реальный
# SMS-провайдер (SMS_PROVIDER_LOGIN + SMS_PROVIDER_PASSWORD ниже). Без кредов:
# вкладка телефона отсутствует на /login, POST /api/auth/otp/{request,verify}
# отвечают 503 SYSTEM_FEATURE_DISABLED до генерации кода. Инвариант QA-003
# («прод + phone-вход + SMS не настроен = plaintext-OTP в логах») теперь
# держится конструктивно: mock-провайдер в проде недостижим.
# Порядок включения: пополнить SMSC-баланс → задать креды → redeploy.

# ── Trusted proxy / client-IP derivation (HARDENING-08 FIX-17) ───────────────
# CONFIRM THE PROD EDGE before setting these. Client IP is taken N-from-the-RIGHT
# of X-Forwarded-For (never the client-spoofable leftmost) — this closes the OTP
# rate-limit bypass AND lets the webhook IP allowlist enforce.
#   TRUSTED_PROXY_HOPS = number of trusted reverse proxies in front of the app.
#   docker-compose binds 127.0.0.1:3000 → at least 1 (the reverse proxy). Set 2
#   if a CDN sits in front of the LB. Too-HIGH re-opens spoofing; too-low just
#   coarsens the key. When unsure, keep 1.
#
# FIX-B17: DO NOT leave this on "probably 1". A wrong value produces no error,
# no log and no failing test — it silently makes every per-IP limit either
# GLOBAL (hops below reality) or BYPASSABLE (hops above reality). Verify it
# against the real edge in one request right after the first deploy:
#   GET /api/admin/diagnostics/client-ip   (admin session required)
# Full procedure, including the spoofed-XFF control probe and how to read each
# wrong result: DEPLOY-BACKLOG.md § 2.1. Record the confirmed number and the
# date here, and re-verify after ANY change to the edge (new CDN, new LB).
TRUSTED_PROXY_HOPS=1
# Optional dedicated real-IP header the edge OVERWRITES (e.g. x-real-ip). Only
# set if the edge is confirmed to set it — otherwise a client can spoof it.
TRUSTED_REAL_IP_HEADER=

# ── Worker / infra ────────────────────────────────────────────────────────────
WORKER_SECRET=replace-with-worker-auth-secret
BILLING_RENEW_SECRET=replace-with-billing-cron-secret
# MRR snapshot daily cron (MRR-SNAPSHOTS-A). Without this set, the
# /api/billing/mrr/snapshot/run endpoint returns 403 and the admin
# billing dashboard MRR delta tile stays at «—». Generate via
# `openssl rand -hex 32`. See docs/runbooks/mrr-snapshot-cron.md.
MRR_SNAPSHOT_SECRET=replace-with-mrr-cron-secret
# Catalog "availableToday" recompute trigger (CATALOG-AVAILABLE-TODAY).
# Fail-closed: without this set, POST /api/catalog/available-today/run
# returns 403 (never runs unauthenticated). Generate via `openssl rand -hex 32`.
AVAILABILITY_CRON_TOKEN=replace-with-availability-cron-secret

# ── App URL ───────────────────────────────────────────────────────────────────
# Must match the public domain (used for absolute links in emails, notifications, etc.)
NEXT_PUBLIC_APP_URL=https://masterryadom.ru
APP_PUBLIC_URL=https://masterryadom.ru

# ── Media storage ─────────────────────────────────────────────────────────────
# Production uses S3 (STORAGE_PROVIDER=s3). The local-disk vars MEDIA_LOCAL_ROOT
# / MEDIA_LOCAL_PUBLIC_URL apply only to STORAGE_PROVIDER=local (dev) — see
# .env.example — and are intentionally omitted here.
STORAGE_PROVIDER=s3
MEDIA_DELIVERY_SECRET=replace-with-media-delivery-secret

# Любой S3-совместимый провайдер. Endpoint/region берутся из консоли —
# в коде дефолтов нет. Порядок переезда на Cloud.ru Object Storage и
# копирование объектов С СОХРАНЕНИЕМ КЛЮЧЕЙ — docs/runbooks/s3-migration-cloudru.md.
S3_BUCKET=replace-with-s3-bucket-name
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
# Прямая раздача/CDN. В рантайме НЕ используется — медиа отдаётся через
# same-origin `/api/media/file/[id]`; оставляйте пустым.
S3_PUBLIC_URL=

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_EMAIL=admin@masterryadom.ru

# ── Telegram ──────────────────────────────────────────────────────────────────
# FIX-TELEGRAM-KILLSWITCH → ENV-SPLIT-01 (2026-08-30): флаг
# NEXT_PUBLIC_TELEGRAM_ENABLED УДАЛЁН. Пользовательский Telegram включён
# наличием NEXT_PUBLIC_TELEGRAM_BOT_USERNAME; при заданном username в проде
# ОБЯЗАТЕЛЕН и TELEGRAM_BOT_TOKEN (env-refine, отказ на старте). Выключить
# Telegram = оставить обе строки пустыми. Админский /settings-тумблер действует
# НИЖЕ этого потолка. Не влияет на ops-мониторинг (MONITORING_TELEGRAM_*).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# 🚩 OAuth redirect_uri (applies to VK + Yandex below).
# The redirect_uri value here is sent verbatim by the app and MUST byte-match what
# you register in the VK / Yandex OAuth console.
# A mismatch = OAuth "redirect_uri mismatch" at launch. Verify after registering.
#
# ⚠️ Смена домена (2026-08-30): продом стал masterryadom.ru — латиница, punycode
# больше не при чём. Значения ниже обновлены, НО их обязательно нужно
# перерегистрировать в консолях VK и Яндекса: сама смена env-переменной старую
# запись в консоли не меняет, и вход через соцсети упадёт с redirect_uri mismatch.
# Прежний кириллический домен: мастеррядом.online == xn--80aic0adlmagk0m.online —
# если для него в консолях остались записи, их можно снять после переезда.
#
# ── VK OAuth ──────────────────────────────────────────────────────────────────
# ENV-SPLIT-01 (2026-08-30): флаг NEXT_PUBLIC_VK_ENABLED УДАЛЁН. VK-вход
# включён наличием VK_CLIENT_ID; при заданном id в проде обязательны и
# VK_CLIENT_SECRET + VK_REDIRECT_URI (env-refine, отказ на старте). Выключить
# VK-вход = оставить креды пустыми. VK_ID_*-алиасы по-прежнему принимаются —
# set ONE set, not both. The redirect_uri must be registered in the VK console.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://masterryadom.ru/api/auth/vk/callback
# VK push-notifications: флаг NEXT_PUBLIC_VK_NOTIFICATIONS_ENABLED УДАЛЁН —
# канала доставки в notifications/delivery.ts не существует, доступность
# захардкожена false В КОДЕ (src/lib/vk/notifications-availability.ts) и
# включается коммитом, который допишет канал, а не env-строкой.

# ── Yandex OAuth (Yandex ID) — FIX-YANDEX-OAUTH ───────────────────────────────
# DEPLOY-OPS: register a Yandex OAuth app (https://oauth.yandex.ru) — scopes
# login:info / login:email / login:avatar, redirect_uri =
# https://masterryadom.ru/api/auth/yandex/callback — then set the creds below.
# ENV-SPLIT-01: флаг NEXT_PUBLIC_YANDEX_ENABLED УДАЛЁН — кнопка появляется с
# заданным YANDEX_OAUTH_CLIENT_ID; при заданном id в проде обязательны и
# YANDEX_OAUTH_SECRET + YANDEX_OAUTH_REDIRECT_URI (env-refine). Выключить = пусто.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://masterryadom.ru/api/auth/yandex/callback

# ── Payments — YooKassa ───────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
# Optional URL query secret (NOT a signature — YooKassa doesn't sign webhooks).
# Configure the ЛК HTTP-уведомления URL as:
#   https://<host>/api/payments/yookassa/webhook?token=<value>
# The worker also re-fetches each payment from the YooKassa API as the primary
# authenticity anchor, so the token is a second cheap pre-filter, not the gate.
#
# 🚨 HARDENING-MISC-01: REQUIRED — with payments enabled the app now FAILS TO
# START without it (previously it degraded silently to a one-time warn). Provision
# it before deploy. To run a prod instance without payments, unset both
# YOOKASSA_SHOP_ID and YOOKASSA_SECRET_KEY instead.
YOOKASSA_WEBHOOK_TOKEN=replace-with-webhook-url-secret
# OPTIONAL — default OFF, and OFF is the intended production setting.
#
# PAY-SEC-01 (2026-07-31, DevOps recommendation accepted): do NOT enforce the
# YooKassa source-IP allowlist in production. Behind the ALB it depends on a
# correct TRUSTED_PROXY_HOPS *and* on YooKassa never changing its published IP
# ranges silently; either one drops LEGITIMATE payment webhooks — subscriptions
# stick unactivated and the failure is invisible until a customer complains.
#
# Safe because webhook authenticity does NOT depend on the source IP:
# src/lib/payments/yookassa/webhook-processor.ts re-fetches the object from the
# YooKassa API (GET /v3/payments|refunds/{id}, Basic auth with the shop creds
# above) and acts ONLY on the API-reported status/amount/metadata. The route
# forwards nothing but {event, object.id}. A forged notification at worst costs
# one API lookup that finds nothing (invariant #5).
#
# ENV-SPLIT-01: флаг YOOKASSA_IP_ALLOWLIST_ENFORCED УДАЛЁН — allowlist ВСЕГДА
# log-only (это и была ратифицированная прод-поза PAY-SEC-01: подлинность
# держит worker API re-fetch, инв. #5; unexpected source IPs логируются).

# ── Address features ─────────────────────────────────────────────────────────
YANDEX_GEOCODER_API_KEY=replace-with-geocoder-key
YANDEX_SUGGEST_API_KEY=replace-with-suggest-key
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-maps-key

# 🚩 LEGAL — real ИНН for the footer requisites. MUST be set before launch
# (152-ФЗ / legal-entity disclosure). Unset → footer shows "[не указан]".
NEXT_PUBLIC_LEGAL_INN=replace-with-real-inn
# 🚩 FOOTER-VK — real МастерРядом VK community URL for the footer social link.
# Unset → footer omits the VK icon (never links a wrong handle). Set before launch.
NEXT_PUBLIC_VK_COMMUNITY_URL=

# ── SMTP (email support tickets) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@masterryadom.ru
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="МастерРядом <noreply@masterryadom.ru>"
SUPPORT_TO=support@masterryadom.ru
# Partnership inquiries from /partners — falls back to SUPPORT_TO when unset.
SUPPORT_TO_PARTNERSHIP=partners@masterryadom.ru
# ENV-SPLIT-01: килсвитч EMAIL_AUTH_ENABLED УДАЛЁН (дефолт всегда был ON).
# Email-вход доступен, когда настроен SMTP выше; выключить = убрать SMTP-креды.

# ── SMS provider (SMSC.ru — https://smsc.ru/api/) ────────────────────────────
# Real SMS delivery for phone OTP login (SMS-GATEWAY-A 2026-05-23).
# ENV-SPLIT-01: флаг SMS_PROVIDER_ENABLED УДАЛЁН. Провайдер (и вместе с ним
# phone-вход в проде — см. Auth section выше) включён наличием пары
# SMS_PROVIDER_LOGIN + SMS_PROVIDER_PASSWORD. Пусто = phone-вход в проде
# выключен, mock-провайдер недостижим, OTP в прод-логи не попадает.
# Порядок: пополнить + верифицировать SMSC-аккаунт, smoke-test на реальных
# RU-операторах, затем задать креды и redeploy.
SMS_PROVIDER_LOGIN=
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_SENDER=
# Low-balance alert threshold in RUB (consumed by future SMS-MONITORING-A
# daily cron — admin balance widget will surface when balance < threshold).
SMS_LOW_BALANCE_THRESHOLD=500

# ── Feature flags ─────────────────────────────────────────────────────────────
# ENV-SPLIT-01: флаги VISUAL_SEARCH_ENABLED / AI_FEATURES_ENABLED УДАЛЕНЫ —
# обе AI-поверхности включены наличием пары YANDEX_API_KEY + YANDEX_FOLDER_ID
# ниже (рантайм-выключатели остаются у админа в SystemConfig). Перед включением
# визуального поиска в env с существующими векторами — см. Visual search ниже.
DEFAULT_TIMEZONE=Europe/Moscow

# ── AI chat + visual search (both on Yandex) ─────────────────────────────────
# Chat surfaces (review summary / review reply / service description / advisor)
# AND visual search run on Yandex Cloud. Chat uses the Foundation Models
# OpenAI-compatible endpoint (https://llm.api.cloud.yandex.net/v1); visual search
# uses AI Studio multimodal (qwen3.6-35b-a3b) + text-search-doc/query embeddings
# (VISUAL-SEARCH-YANDEX-MIGRATION-01). Setting BOTH vars below turns the AI
# surfaces ON (ENV-SPLIT-01); leaving them empty turns them off. Get values from
# the Yandex Cloud console:
#   • YANDEX_API_KEY = service account API key, scope yc.ai.foundationModels.execute
#   • YANDEX_FOLDER_ID = folder identifier (used in model URI, format b1g...)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# (AI_PROVIDER removed by ENV-REVISION 2026-07-04; OPENAI_API_KEY removed by
# VISUAL-SEARCH-YANDEX-MIGRATION-01 — visual search is Yandex-native now.)

# ── Visual search ────────────────────────────────────────────────────────────
# Vision (classify + describe via qwen3.6-35b-a3b) + text-search embeddings run
# on Yandex (see YANDEX_* above). Inactive while YANDEX_* creds are empty.
# Before enabling in an env that already holds vectors, run
# scripts/backfill-visual-embeddings.ts --apply to re-embed at the new dimension.

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=

# ── Error tracking — GlitchTip (OBSERVABILITY-GLITCHTIP-01) ───────────────────
# Self-hosted, Sentry-ingest-compatible. Chosen over SaaS Sentry so error
# payloads (which can carry request context) stay in-country — 152-ФЗ.
#
# 🚩 The DSN MUST be https. The production CSP (src/proxy.ts) sets
# `connect-src 'self' https: wss:` — any https origin is already allowed, so no
# CSP change is needed. An http:// DSN would be blocked in the browser and
# client-side reporting would silently do nothing.
#
# Both DSNs are safe to expose (a Sentry/GlitchTip DSN is a write-only ingest
# key, not a secret) — but keep the two projects separate so a burst of browser
# noise cannot bury backend failures.
#
# Server + worker (set the SAME value in the worker's env — the worker is a
# separate process and is the highest-value target: its failures are silent).
GLITCHTIP_DSN=https://replace-with-public-key@glitchtip.example.com/1
NEXT_PUBLIC_GLITCHTIP_DSN=https://replace-with-public-key@glitchtip.example.com/2
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=production
# Set to the deployed git SHA so events group by release. Readable stack traces
# from MINIFIED client code additionally need source-map upload — deferred, see
# OBSERVABILITY-GLITCHTIP-SOURCEMAPS in BACKLOG.md.
NEXT_PUBLIC_GLITCHTIP_RELEASE=
# 1 = send every error. Lower only if event volume becomes a disk problem on the
# GlitchTip host (retention/disk are the operator's call — see the deploy notes).
GLITCHTIP_SAMPLE_RATE=1
