# ─────────────────────────────────────────────────────────────────────────────
# Production environment — copy to .env.production and fill in real values.
# Never commit the real .env.production to git.
#
# Docker-compose reads this file via:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# Synced to src/lib/env.ts schema by PROD-ENV-EXAMPLE-SYNC-A (2026-05-23 —
# closes DR-1 from DEPLOYMENT-READINESS-AUDIT-A). When env.ts changes,
# update this template alongside .env.example (per SPRINT-PATTERNS Pattern 5:
# sync ALL examples — dev AND prod — to avoid silent prod regressions).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Used by docker-compose postgres service and the app/worker containers.
# Production hosting TBD (pending DevOps decision — managed Postgres OR self-hosted).
# pgvector extension required (used for visual-search embeddings via MediaAssetEmbedding).
POSTGRES_DB=masterryadom
POSTGRES_USER=masterryadom
POSTGRES_PASSWORD=replace-with-strong-password

# Prisma connection URL. For self-hosted compose-internal Postgres use host=postgres;
# for managed Postgres (Yandex Managed PostgreSQL OR equivalent — DevOps decision) use the provider-issued host.
# Note: Supabase not used (РФ accessibility); choose provider that's reachable from production VM.
DATABASE_URL=postgresql://masterryadom:replace-with-strong-password@postgres:5432/masterryadom?schema=public

# Prisma direct URL — used by `prisma migrate deploy` to bypass pgbouncer if present.
# If you are NOT using pgbouncer, set this to the same value as DATABASE_URL.
DIRECT_URL=postgresql://masterryadom:replace-with-strong-password@postgres:5432/masterryadom?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379
# Optional connection/command timeouts (ms). Defaults applied when unset.
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=replace-with-64-char-random-secret
OTP_HMAC_SECRET=replace-with-separate-64-char-random-secret
AUTH_COOKIE_NAME=bh_session

# ── Worker / infra ────────────────────────────────────────────────────────────
WORKER_SECRET=replace-with-worker-auth-secret
BILLING_RENEW_SECRET=replace-with-billing-cron-secret
# MRR snapshot daily cron (MRR-SNAPSHOTS-A). Without this set, the
# /api/billing/mrr/snapshot/run endpoint returns 403 and the admin
# billing dashboard MRR delta tile stays at «—». Generate via
# `openssl rand -hex 32`. See docs/runbooks/mrr-snapshot-cron.md.
MRR_SNAPSHOT_SECRET=replace-with-mrr-cron-secret

# ── App URL ───────────────────────────────────────────────────────────────────
# Must match the public domain (used for absolute links in emails, notifications, etc.)
NEXT_PUBLIC_APP_URL=https://beautyhub.art
APP_PUBLIC_URL=https://beautyhub.art

# ── Media storage ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=s3
MEDIA_DELIVERY_SECRET=replace-with-media-delivery-secret

S3_BUCKET=replace-with-s3-bucket-name
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
# Public CDN URL for media assets (leave empty to serve through proxy)
S3_PUBLIC_URL=

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_EMAIL=admin@beautyhub.art

# ── Telegram ──────────────────────────────────────────────────────────────────
# FIX-TELEGRAM-KILLSWITCH: legal kill-switch for user-facing Telegram. Default
# false = OFF (Telegram absent from UI + inert in delivery). Launch ships with
# this OFF. The admin /settings toggle can only act BELOW this env ceiling — it
# can never re-enable Telegram while this is false. Does NOT affect the internal
# ops-monitoring Telegram (MONITORING_TELEGRAM_* below).
NEXT_PUBLIC_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=replace-with-bot-username

# ── VK OAuth ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VK_ENABLED=false
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://beautyhub.art/api/auth/vk/callback
# VK push-notifications subsystem (delivery channel). Independent of
# NEXT_PUBLIC_VK_ENABLED (login). Default off — set to true only after the
# delivery channel in notifications/delivery.ts ships (queue handler + VK
# send API). UI gates the toggle when this is off (VK-NOTIFICATIONS-FLAG-A).
NEXT_PUBLIC_VK_NOTIFICATIONS_ENABLED=false

# ── Payments — YooKassa ───────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
YOOKASSA_WEBHOOK_TOKEN=replace-with-webhook-bearer-token

# ── Address features ─────────────────────────────────────────────────────────
YANDEX_GEOCODER_API_KEY=replace-with-geocoder-key
YANDEX_SUGGEST_API_KEY=replace-with-suggest-key
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-maps-key

# 🚩 LEGAL — real ИНН for the footer requisites. MUST be set before launch
# (152-ФЗ / legal-entity disclosure). Unset → footer shows "[не указан]".
NEXT_PUBLIC_LEGAL_INN=replace-with-real-inn
# 🚩 FOOTER-VK — real МастерРядом VK community URL for the footer social link.
# Unset → footer omits the VK icon (never links a wrong handle). Set before launch.
NEXT_PUBLIC_VK_COMMUNITY_URL=

# ── SMTP (email support tickets) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@beautyhub.art
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="МастерРядом <noreply@beautyhub.art>"
SUPPORT_TO=support@beautyhub.art
# Partnership inquiries from /partners — falls back to SUPPORT_TO when unset.
SUPPORT_TO_PARTNERSHIP=partners@beautyhub.art
# Enable cabinet email-OTP login flow (also used by email-change verify).
# Set to true after SMTP creds verified working in production.
EMAIL_AUTH_ENABLED=true

# ── SMS provider (SMSC.ru — https://smsc.ru/api/) ────────────────────────────
# Real SMS delivery for phone OTP login (SMS-GATEWAY-A 2026-05-23).
# When SMS_PROVIDER_ENABLED=false the app falls back to logging the OTP
# code into application logs (dev workflow) — DO NOT leave false in prod
# (users won't receive codes). When true, SMS_PROVIDER_LOGIN +
# SMS_PROVIDER_PASSWORD are required (env.ts refine fails startup if
# missing). Optional SENDER overrides the registered alpha-sender.
SMS_PROVIDER_ENABLED=true
SMS_PROVIDER_LOGIN=replace-with-smsc-login
SMS_PROVIDER_PASSWORD=replace-with-smsc-password
SMS_PROVIDER_SENDER=
# Low-balance alert threshold in RUB (consumed by future SMS-MONITORING-A
# daily cron — admin balance widget will surface when balance < threshold).
SMS_LOW_BALANCE_THRESHOLD=500

# ── Feature flags ─────────────────────────────────────────────────────────────
VISUAL_SEARCH_ENABLED=false
AI_FEATURES_ENABLED=true
DEFAULT_TIMEZONE=Europe/Moscow

# ── AI chat surfaces (post-migration 2026-05-31 — OPENAI-CLEANUP-A) ──────────
# Chat surfaces (review summary / review reply / service description / advisor)
# go through Yandex Cloud Foundation Models via the OpenAI-compatible endpoint
# (https://llm.api.cloud.yandex.net/v1). When AI_FEATURES_ENABLED=true, both
# vars below are required. Get values from Yandex Cloud console:
#   • YANDEX_API_KEY = service account API key, scope yc.ai.foundationModels.execute
#   • YANDEX_FOLDER_ID = folder identifier (used in model URI, format b1g...)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── Visual search (separate post-launch track) ───────────────────────────────
# Visual search (`src/lib/visual-search/*`) imports the OpenAI SDK directly
# for image classification + embeddings. Currently inactive (defaults off).
# Its migration to Yandex (vision + embeddings) is post-launch independent
# work. OPENAI_API_KEY is required ONLY when VISUAL_SEARCH_ENABLED=true.
OPENAI_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
